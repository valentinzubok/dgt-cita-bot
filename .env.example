# Токен бота от @BotFather
TELEGRAM_TOKEN=

# Как часто проверять, в минутах (минимум 5). Чаще не стоит — сайт DGT начинает тормозить.
CHECK_INTERVAL_MIN=10

# Строка подключения к Postgres (Neon). Пусто — локальный файл bot.db.
DATABASE_URL=

# Кому разрешено пользоваться ботом (chat id через запятую). Пусто — всем.
ALLOWED_CHAT_IDS=

# Твой chat id — откроет команду /admin со статистикой.
ADMIN_CHAT_ID=
